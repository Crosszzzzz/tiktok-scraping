# REFERENCIA: Huella NO carga .env automáticamente.
# Configura variables con $env:NOMBRE = 'valor' en PowerShell antes de iniciar.
# Más instrucciones en README.md. Reinicia el servidor después de cambiarlas.

# Omite esta variable para usar <proyecto>/data. Se recomienda ruta absoluta.
# HUELLA_DATA_DIR=D:/Huella/datos
# HUELLA_PORT=8765
# HUELLA_RELOAD=0

# Transcripción opcional. Paquete faster-whisper y modelo deben prepararse aparte.
# Una ruta local o nombre ya presente en caché; vacío desactiva transcripción.
WHISPER_MODEL=
# Solo 1 autoriza descargar el modelo configurado. Predeterminado: sin descargas.
WHISPER_ALLOW_DOWNLOAD=0

# Visión opcional. Usa un modelo compatible con imágenes YA instalado en Ollama.
# Sin nombre, no se realizan solicitudes de descripción visual.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Timeout de cada petición, limitado en código a 5–120 segundos.
OLLAMA_TIMEOUT_SECONDS=60

# Alternativa cloud: también puedes introducirla en Ajustes IA del panel.
# Selecciona Gemini allí. Nunca publiques una clave real en este archivo.
GEMINI_API_KEY=
